import { memo } from "react";
import { Link } from "react-router-dom";
import { useSelector } from "react-redux";
import { MapPin, Tag, AlertTriangle, Clock, User, Store, Truck } from "lucide-react";
import { getDeliveryTimeInfo } from "../utils/deliveryCalculator";
import { saveRecentlyViewedProduct } from "../utils/recentlyViewed";

// ✅ Wrap with memo to prevent re-renders when parent updates
const ProductCard = memo(({ product }) => {
  const { user } = useSelector((state) => state.auth);

  const discountPercent = Math.round(
    ((product.marketPrice - product.discountPrice) / product.marketPrice) * 100
  );

  const daysUntilExpiry = Math.ceil(
    (new Date(product.expiryDate) - new Date()) / (1000 * 60 * 60 * 24)
  );

  const isExpired = daysUntilExpiry < 0;
  const isMyProduct = user && (
    product.owner === user._id || 
    (product.owner && product.owner._id === user._id)
  );

  // 🚚 Calculate estimated delivery time based on user & store locations
  const storeLat = product.location?.coordinates?.[1] || 0;
  const storeLon = product.location?.coordinates?.[0] || 0;
  const deliveryInfo = getDeliveryTimeInfo(
    user?.latitude || 0,
    user?.longitude || 0,
    storeLat,
    storeLon
  );

  // ✅ Pre-compute className to avoid inline object creation
  const cardClass = isMyProduct 
    ? "group relative bg-[#0f1520]/90 border border-dashed border-emerald-500/40 rounded-3xl overflow-hidden backdrop-blur-md transition-all duration-500 h-full flex flex-col cursor-default opacity-80 hover:border-emerald-500/60"
    : isExpired
    ? "group relative bg-[#0a0e17]/80 border border-gray-800/40 rounded-3xl overflow-hidden backdrop-blur-md transition-all duration-500 h-full flex flex-col cursor-not-allowed opacity-50 grayscale"
    : "group relative bg-[#111827]/80 border border-gray-800/60 rounded-3xl overflow-hidden backdrop-blur-md transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-emerald-900/20 hover:border-emerald-500/30 h-full flex flex-col cursor-pointer";

  const cardContent = (
    <div className={cardClass}>
      {/* Image Container — Full Image, No Zoom */}
      <div className="relative w-full aspect-[4/3] bg-gradient-to-b from-[#1a2235] to-[#0f1520] p-5 flex items-center justify-center overflow-hidden">
        <img
          src={product.image || "https://via.placeholder.com/300x200?text=No+Image"}
          alt={product.name}
          loading="lazy"
          className="w-full h-full object-contain drop-shadow-2xl transition-transform duration-700 group-hover:scale-105"
        />
        
        {/* Top Left Badges */}
        <div className="absolute top-3 left-3 flex flex-col gap-2">
          {discountPercent > 0 && (
            <div className="flex items-center gap-1 px-2.5 py-1 bg-rose-500/20 border border-rose-500/30 text-rose-300 text-[10px] font-bold uppercase tracking-wider rounded-lg backdrop-blur-md">
              <Tag size={10} />
              {discountPercent}% OFF
            </div>
          )}
        </div>

        {/* Top Right Status Badge */}
        <div className="absolute top-3 right-3 flex flex-col gap-2">
          {isExpired ? (
            <div className="flex items-center gap-1 px-2.5 py-1 bg-gray-600/80 border border-gray-500/30 text-gray-300 text-[10px] font-bold uppercase tracking-wider rounded-lg backdrop-blur-md">
              <AlertTriangle size={10} />
              Expired
            </div>
          ) : isMyProduct ? (
            <div className="flex items-center gap-1 px-2.5 py-1 bg-emerald-600/30 border border-emerald-500/30 text-emerald-300 text-[10px] font-bold uppercase tracking-wider rounded-lg backdrop-blur-md">
              <Store size={10} />
              Your Listing
            </div>
          ) : daysUntilExpiry <= 3 ? (
            <div className="flex items-center gap-1 px-2.5 py-1 bg-amber-500/20 border border-amber-500/30 text-amber-300 text-[10px] font-bold uppercase tracking-wider rounded-lg backdrop-blur-md">
              <Clock size={10} />
              {daysUntilExpiry}d left
            </div>
          ) : null}
        </div>

        {/* Bottom Gradient Fade */}
        <div className="absolute bottom-0 left-0 right-0 h-12 bg-gradient-to-t from-[#111827] to-transparent pointer-events-none" />
      </div>

      {/* Content */}
      <div className="p-5 flex flex-col flex-grow">
        {/* Category & Name */}
        <div className="mb-3">
          <span className="text-[10px] font-bold text-emerald-400/70 uppercase tracking-widest mb-1.5 block">
            {product.category}
          </span>
          <h3 className="font-bold text-white text-lg leading-tight group-hover:text-emerald-300 transition-colors duration-300 line-clamp-2">
            {product.name}
          </h3>
        </div>

        {/* Description */}
        <p className="text-sm text-gray-500 mb-4 line-clamp-2 leading-relaxed">
          {product.description}
        </p>

        {/* Price */}
        <div className="flex items-baseline gap-2.5 mb-3">
          <span className="text-2xl font-extrabold text-emerald-400 tracking-tight">
            ₹{product.discountPrice}
          </span>
          {discountPercent > 0 && (
            <span className="text-sm text-gray-600 line-through font-medium">
              ₹{product.marketPrice}
            </span>
          )}
          {discountPercent > 0 && (
            <span className="text-[10px] font-bold text-rose-400 bg-rose-500/10 px-2 py-0.5 rounded-md">
              SAVE ₹{product.marketPrice - product.discountPrice}
            </span>
          )}
        </div>

        {/* 🚚 Delivery Time & Distance Indicator */}
        {!isExpired && (
          <div className="mb-4 px-2.5 py-1.5 bg-emerald-500/10 border border-emerald-500/20 rounded-xl flex items-center justify-between text-xs text-emerald-300 font-semibold">
            <div className="flex items-center gap-1.5">
              <Truck size={13} className="text-emerald-400" />
              <span>{deliveryInfo.formattedTime}</span>
            </div>
            <span className="text-[10px] text-gray-400 font-medium">
              ({deliveryInfo.distanceKm} km away)
            </span>
          </div>
        )}

        {/* Meta Info */}
        <div className="flex items-center justify-between text-xs text-gray-500 mb-4">
          <div className="flex items-center gap-1.5 bg-[#0f1520] px-2.5 py-1.5 rounded-lg border border-gray-800/50">
            <Tag size={11} className="text-emerald-500/70" />
            <span className="font-medium">{product.quantity} {product.unit}</span>
          </div>
          <div className="flex items-center gap-1.5 bg-[#0f1520] px-2.5 py-1.5 rounded-lg border border-gray-800/50">
            <MapPin size={11} className="text-emerald-500/70" />
            <span className="font-medium">{product.city || "Nearby"}</span>
          </div>
        </div>

        {/* Spacer */}
        <div className="flex-grow" />

        {/* Footer: Owner & Type */}
        <div className="pt-4 border-t border-gray-800/50 flex items-center justify-between">
          <div className="flex items-center gap-2">
            <div className="w-6 h-6 rounded-full bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center">
              <User size={12} className="text-emerald-400" />
            </div>
            <span className="text-xs text-gray-400 font-medium truncate max-w-[100px]">
              {product.ownerName}
            </span>
          </div>
          <span className="text-[10px] font-bold uppercase tracking-wider bg-[#1a2235] text-gray-400 px-3 py-1 rounded-full border border-gray-800/50">
            {product.ownerType}
          </span>
        </div>

        {/* Expired Warning */}
        {isExpired && (
          <div className="mt-4 p-3 bg-rose-500/10 border border-rose-500/20 rounded-xl text-center">
            <p className="text-xs text-rose-400 font-semibold flex items-center justify-center gap-1.5">
              <AlertTriangle size={12} />
              This product has expired
            </p>
          </div>
        )}
      </div>
    </div>
  );

  if (isMyProduct || isExpired) {
    return <div className="block h-full">{cardContent}</div>;
  }

  return (
    <Link
      to={`/checkout/${product._id}`}
      onClick={() => saveRecentlyViewedProduct(product)}
      className="block h-full"
    >
      {cardContent}
    </Link>
  );
});

ProductCard.displayName = "ProductCard";

export default ProductCard;
</file>

<file path="src/components/ProductForm.jsx">
import { useState, useEffect, useRef, useCallback, memo } from "react";
import { createPortal } from "react-dom";
import { useDispatch, useSelector } from "react-redux";
import { createProduct, updateProduct } from "../redux/thunks/productThunks";
import { setFormOpen, setEditingProduct } from "../redux/slices/productSlice";
import { X, Upload, Search, Tag, Plus, Minus, Check, AlertCircle } from "lucide-react";
import {
  getProductNameError,
  getPriceError,
  getQuantityError,
  getStockError,
  getDescriptionError,
  getExpiryDateError,
  validateForm
} from "../utils/validation";
import toast from "react-hot-toast";

const CATEGORIES = [
  "Grocery Items",
  "Fruits",
  "Vegetables",
  "Meat/Fish",
  "Dairy",
  "Other",
];

const UNITS = ["kg", "g", "ltr", "ml", "units", "packs", "pieces","tray","dozen","bunch","bottle","box","packet"];

const PRODUCT_NAMES = {
  "Grocery Items": ["Rice", "Wheat Flour", "Sugar", "Salt", "Cooking Oil", "Pulses", "Spices", "Dal", "Tea"],
  "Fruits": ["Apples", "Bananas", "Oranges", "Mangoes", "Grapes", "Watermelon", "Papaya", "Guava"],
  "Vegetables": ["Tomatoes", "Potatoes", "Onions", "Carrots", "Spinach", "Cauliflower", "Brinjal", "Chili"],
  "Meat/Fish": ["Chicken", "Mutton", "Fish", "Prawns", "Eggs"],
  "Dairy": ["Milk", "Cheese", "Butter", "Yogurt", "Paneer", "Cream", "Ghee"],
  "Other": ["Bread", "Biscuits", "Noodles", "Snacks", "Chips", "Juice"],
};

const BRANDS = {
  "Grocery Items": ["Aashirvaad", "Fortune", "Tata Sampann", "MDH", "Catch", "India Gate","Local"],
  "Fruits": ["Organic", "Fresh", "Local Farm"],
  "Vegetables": ["Organic", "Fresh", "Local Farm"],
  "Meat/Fish": ["Fresho", "Zorabian", "Local"],
  "Dairy": ["Amul", "Mother Dairy", "Nestle", "Britannia","Local Farm"],
  "Other": ["Britannia", "Parle", "Maggi", "Sunfeast", "Lays"],
};

// MOVED OUTSIDE: FormInput is now a standalone memoized component
const FormInput = memo(({ label, name, type = "text", icon: Icon, placeholder, value, onChange, onBlur, error, touched, required, min, step }) => {
  const hasError = touched && error;
  const isValid = touched && !error && value && value.toString().trim() !== "";

  return (
    <div className="w-full">
      <label className="block text-xs font-semibold text-gray-300 mb-1.5">
        {label} {required && <span className="text-emerald-400">*</span>}
      </label>
      <div className="relative">
        {Icon && <Icon size={16} className="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-500" />}
        <input
          type={type}
          name={name}
          value={value}
          onChange={onChange}
          onBlur={onBlur}
          placeholder={placeholder}
          required={required}
          min={min}
          step={step}
          className={`w-full bg-gray-950/60 border rounded-xl py-3 text-xs text-white placeholder-gray-500 outline-none transition-all shadow-inner ${
            Icon ? "pl-10" : "pl-3.5"
          } pr-10 ${
            hasError 
              ? "border-red-500/80 focus:ring-2 focus:ring-red-500/20" 
              : isValid
              ? "border-emerald-500/80 focus:ring-2 focus:ring-emerald-500/20"
              : "border-gray-800 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"
          }`}
        />
        {touched && (
          <div className="absolute right-3.5 top-1/2 -translate-y-1/2">
            {hasError ? (
              <AlertCircle size={15} className="text-red-400" />
            ) : (
              <Check size={15} className="text-emerald-400" />
            )}
          </div>
        )}
      </div>
      {hasError && (
        <p className="text-[11px] text-red-400 mt-1 font-medium">{error}</p>
      )}
    </div>
  );
});
FormInput.displayName = "FormInput";

const ProductForm = () => {
  const dispatch = useDispatch();
  const { editingProduct, loading } = useSelector((state) => state.product);

  const [formData, setFormData] = useState({
    name: "",
    brand: "",
    description: "",
    category: "Grocery Items",
    marketPrice: "",
    discountPrice: "",
    quantity: "",
    unit: "kg",
    stock: "1",
    expiryDate: "",
  });

  const [image, setImage] = useState(null);
  const [imagePreview, setImagePreview] = useState("");

  const [errors, setErrors] = useState({});
  const [touched, setTouched] = useState({});

  const [showNameSuggestions, setShowNameSuggestions] = useState(false);
  const [showBrandSuggestions, setShowBrandSuggestions] = useState(false);
  const [quickDiscount, setQuickDiscount] = useState(null);

  const nameRef = useRef(null);
  const brandRef = useRef(null);

  useEffect(() => {
    if (editingProduct) {
      setFormData({
        name: editingProduct.name || "",
        brand: editingProduct.brand || "",
        description: editingProduct.description || "",
        category: editingProduct.category || "Grocery Items",
        marketPrice: editingProduct.marketPrice?.toString() || "",
        discountPrice: editingProduct.discountPrice?.toString() || "",
        quantity: editingProduct.quantity?.toString() || "",
        unit: editingProduct.unit || "kg",
        stock: editingProduct.stock?.toString() || "1",
        expiryDate: editingProduct.expiryDate
          ? new Date(editingProduct.expiryDate).toISOString().split("T")[0]
          : "",
      });
      if (editingProduct.image) setImagePreview(editingProduct.image);
    }
  }, [editingProduct]);

  useEffect(() => {
    const handleClick = (e) => {
      if (!nameRef.current?.contains(e.target)) setShowNameSuggestions(false);
      if (!brandRef.current?.contains(e.target)) setShowBrandSuggestions(false);
    };
    document.addEventListener("mousedown", handleClick);
    return () => document.removeEventListener("mousedown", handleClick);
  }, []);

  const validateField = useCallback((name, value) => {
    switch (name) {
      case "name":
        return getProductNameError(value);
      case "marketPrice":
        return getPriceError(value, "Market Price");
      case "discountPrice":
        return getPriceError(value, "Discount Price");
      case "quantity":
        return getQuantityError(value);
      case "stock":
        return getStockError(value);
      case "expiryDate":
        return getExpiryDateError(value);
      case "description":
        return getDescriptionError(value);
      default:
        return null;
    }
  }, []);

  const handleChange = useCallback((e) => {
    const { name, value } = e.target;
    setFormData(prev => ({ ...prev, [name]: value }));

    setErrors(prev => {
      if (!prev[name]) return prev;
      const newErrors = { ...prev };
      delete newErrors[name];
      return newErrors;
    });
  }, []);

  const handleBlur = useCallback((e) => {
    const { name, value } = e.target;
    setTouched(prev => ({ ...prev, [name]: true }));
    setErrors(prev => ({ ...prev, [name]: validateField(name, value) }));
  }, [validateField]);

  const pickName = useCallback((name) => {
    setFormData(prev => ({ ...prev, name }));
    setShowNameSuggestions(false);
    setTouched(prev => ({ ...prev, name: true }));
    setErrors(prev => ({ ...prev, name: getProductNameError(name) }));
  }, []);

  const pickBrand = useCallback((brand) => {
    setFormData(prev => ({ ...prev, brand }));
    setShowBrandSuggestions(false);
  }, []);

  const applyDiscount = useCallback((percent) => {
    setQuickDiscount(percent);
    setFormData(prev => {
      if (!prev.marketPrice) return prev;
      const marketPriceNum = parseFloat(prev.marketPrice);
      if (isNaN(marketPriceNum) || marketPriceNum <= 0) return prev;
      const discount = marketPriceNum * (1 - percent / 100);
      const discountStr = Math.round(discount).toString();
      return { ...prev, discountPrice: discountStr };
    });
    setTouched(prev => ({ ...prev, discountPrice: true }));
  }, []);

  const setQuantity = useCallback((qty) => {
    const qtyStr = qty.toString();
    setFormData(prev => ({ ...prev, quantity: qtyStr }));
    setTouched(prev => ({ ...prev, quantity: true }));
    setErrors(prev => ({ ...prev, quantity: getQuantityError(qtyStr) }));
  }, []);

  const changeStock = useCallback((delta) => {
    setFormData(prev => {
      const currentStock = parseInt(prev.stock) || 1;
      const newStock = Math.max(1, currentStock + delta);
      return { ...prev, stock: newStock.toString() };
    });
    setTouched(prev => ({ ...prev, stock: true }));
  }, []);

  const handleStockInput = useCallback((e) => {
    const value = e.target.value;
    if (value === "") {
      setFormData(prev => ({ ...prev, stock: "" }));
      return;
    }
    const num = parseInt(value);
    if (!isNaN(num) && num >= 1) {
      setFormData(prev => ({ ...prev, stock: value }));
    }
  }, []);

  const handleQuantityInput = useCallback((e) => {
    const value = e.target.value;
    if (value === "") {
      setFormData(prev => ({ ...prev, quantity: "" }));
      return;
    }
    const num = parseFloat(value);
    if (!isNaN(num) && num >= 0) {
      setFormData(prev => ({ ...prev, quantity: value }));
    }
  }, []);

  const setExpiry = useCallback((days) => {
    const d = new Date();
    d.setDate(d.getDate() + days);
    const dateStr = d.toISOString().split("T")[0];
    setFormData(prev => ({ ...prev, expiryDate: dateStr }));
    setTouched(prev => ({ ...prev, expiryDate: true }));
    setErrors(prev => ({ ...prev, expiryDate: getExpiryDateError(dateStr) }));
  }, []);

  const handleImage = useCallback((e) => {
    const file = e.target.files[0];
    if (file) {
      const validTypes = ["image/jpeg", "image/jpg", "image/png", "image/webp"];
      if (!validTypes.includes(file.type)) {
        toast.error("Only JPG, PNG, or WEBP images allowed");
        return;
      }
      if (file.size > 5 * 1024 * 1024) {
        toast.error("Image too large. Max 5MB allowed");
        return;
      }
      setImage(file);
      setImagePreview(URL.createObjectURL(file));
    }
  }, []);

  const handleSubmit = useCallback((e) => {
    e.preventDefault();

    const allTouched = {
      name: true, marketPrice: true, discountPrice: true,
      quantity: true, stock: true, expiryDate: true
    };
    setTouched(allTouched);

    const newErrors = {
      name: getProductNameError(formData.name),
      marketPrice: getPriceError(formData.marketPrice, "Market Price"),
      discountPrice: getPriceError(formData.discountPrice, "Discount Price"),
      quantity: getQuantityError(formData.quantity),
      stock: getStockError(formData.stock),
      expiryDate: getExpiryDateError(formData.expiryDate),
      description: getDescriptionError(formData.description),
    };

    const mp = Number(formData.marketPrice);
    const dp = Number(formData.discountPrice);
    if (!isNaN(mp) && !isNaN(dp) && dp >= mp && mp > 0) {
      newErrors.discountPrice = "Discount price must be less than market price";
    }

    if (!UNITS.includes(formData.unit)) {
      newErrors.unit = `Invalid unit "${formData.unit}". Must be one of: ${UNITS.join(", ")}`;
    }

    setErrors(newErrors);

    const { isValid } = validateForm(newErrors);
    if (!isValid) {
      toast.error("Please fix the errors in the form");
      return;
    }

    const data = new FormData();
    Object.keys(formData).forEach(k => data.append(k, formData[k]));
    if (image) data.append("image", image);

    if (editingProduct) {
      dispatch(updateProduct(editingProduct._id, data));
    } else {
      dispatch(createProduct(data));
    }
  }, [formData, image, editingProduct, dispatch]);

  const handleClose = useCallback(() => {
    dispatch(setFormOpen(false));
    dispatch(setEditingProduct(null));
  }, [dispatch]);

  const names = PRODUCT_NAMES[formData.category] || [];
  const brands = BRANDS[formData.category] || [];

  return createPortal(
    <div className="fixed inset-0 bg-black/70 backdrop-blur-md flex items-center justify-center z-[9999] p-4 overflow-y-auto">
      <div className="bg-gray-900 border border-gray-800 rounded-3xl w-full max-w-2xl my-auto max-h-[90vh] flex flex-col shadow-2xl overflow-hidden backdrop-blur-2xl">

        {/* Modal Header */}
        <div className="p-4 sm:p-5 border-b border-gray-800/80 flex justify-between items-center bg-gray-950/40 shrink-0">
          <h2 className="text-base font-bold text-white flex items-center gap-2.5">
            <div className="w-8 h-8 bg-emerald-500/10 border border-emerald-500/20 rounded-xl flex items-center justify-center">
              <Tag size={17} className="text-emerald-400" />
            </div>
            {editingProduct ? "Edit Product" : "Post New Product"}
          </h2>
          <button 
            onClick={handleClose} 
            className="p-2 text-gray-400 hover:text-white hover:bg-gray-800 rounded-xl transition-all cursor-pointer"
          >
            <X size={18} />
          </button>
        </div>

        {/* Scrollable Form Content */}
        <form onSubmit={handleSubmit} className="flex-1 overflow-y-auto p-4 sm:p-6 space-y-4 custom-scrollbar">
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">

            {/* Product Name */}
            <div className="md:col-span-2 relative" ref={nameRef}>
              <FormInput
                label="Product Name"
                name="name"
                icon={Search}
                placeholder="Type or pick from list..."
                required
                value={formData.name}
                onChange={handleChange}
                onBlur={handleBlur}
                error={errors.name}
                touched={touched.name}
                onFocus={() => setShowNameSuggestions(true)}
              />
              {showNameSuggestions && !editingProduct && (
                <div className="absolute z-20 w-full mt-1.5 bg-gray-900 border border-gray-800 rounded-2xl shadow-2xl max-h-40 overflow-y-auto">
                  <p className="text-[11px] text-gray-400 px-3.5 py-2 border-b border-gray-800/80 font-medium">Tap to select ↓</p>
                  {names.map(n => (
                    <button key={n} type="button" onClick={() => pickName(n)}
                      className="w-full text-left px-3.5 py-2.5 text-xs hover:bg-emerald-500/10 text-gray-200 transition-colors">
                      {n}
                    </button>
                  ))}
                </div>
              )}
            </div>

            {/* Brand */}
            <div className="relative" ref={brandRef}>
              <FormInput
                label="Brand"
                name="brand"
                icon={Tag}
                placeholder="Type or pick..."
                value={formData.brand}
                onChange={handleChange}
                onBlur={handleBlur}
                error={errors.brand}
                touched={touched.brand}
                onFocus={() => setShowBrandSuggestions(true)}
              />
              {showBrandSuggestions && !editingProduct && (
                <div className="absolute z-20 w-full mt-1.5 bg-gray-900 border border-gray-800 rounded-2xl shadow-2xl max-h-36 overflow-y-auto">
                  {brands.map(b => (
                    <button key={b} type="button" onClick={() => pickBrand(b)}
                      className="w-full text-left px-3.5 py-2.5 text-xs hover:bg-emerald-500/10 text-gray-200 transition-colors">
                      {b}
                    </button>
                  ))}
                </div>
              )}
            </div>

            {/* Category */}
            <div>
              <label className="block text-xs font-semibold text-gray-300 mb-1.5">Category <span className="text-emerald-400">*</span></label>
              <select 
                name="category" 
                value={formData.category} 
                onChange={handleChange} 
                className="w-full bg-gray-950/60 border border-gray-800 rounded-xl py-3 px-3.5 text-xs text-white outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all shadow-inner cursor-pointer"
              >
                {CATEGORIES.map(c => <option key={c} value={c} className="bg-gray-900 text-white">{c}</option>)}
              </select>
            </div>

            {/* Description */}
            <div className="md:col-span-2">
              <label className="block text-xs font-semibold text-gray-300 mb-1.5">Description</label>
              <textarea 
                name="description" 
                value={formData.description} 
                onChange={handleChange} 
                onBlur={handleBlur}
                rows={2} 
                className={`w-full bg-gray-950/60 border rounded-xl p-3.5 text-xs text-white placeholder-gray-500 outline-none transition-all shadow-inner ${errors.description ? "border-red-500/80 focus:ring-2 focus:ring-red-500/20" : "border-gray-800 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"}`} 
                placeholder="About this product..."
              />
              {errors.description && <p className="text-[11px] text-red-400 mt-1 font-medium">{errors.description}</p>}
              <p className="text-[11px] text-gray-400 mt-1">{formData.description.length}/500 characters</p>
            </div>

            {/* Market Price */}
            <FormInput
              label="Market Price (₹)"
              name="marketPrice"
              type="number"
              placeholder="Original price"
              required
              min="0"
              step="0.01"
              value={formData.marketPrice}
              onChange={handleChange}
              onBlur={handleBlur}
              error={errors.marketPrice}
              touched={touched.marketPrice}
            />

            {/* Discount Price */}
            <div>
              <FormInput
                label="Discount Price (₹)"
                name="discountPrice"
                type="number"
                placeholder="Selling price"
                required
                min="0"
                step="0.01"
                value={formData.discountPrice}
                onChange={handleChange}
                onBlur={handleBlur}
                error={errors.discountPrice}
                touched={touched.discountPrice}
              />
              <div className="flex gap-2 mt-2">
                {[20, 30, 50].map(p => (
                  <button key={p} type="button" onClick={() => applyDiscount(p)}
                    className={`text-[11px] font-semibold px-2.5 py-1 rounded-lg border transition-all cursor-pointer ${quickDiscount===p ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/40 shadow-inner' : 'bg-gray-950/40 text-gray-400 border-gray-800 hover:border-emerald-500/30 hover:text-white'}`}>
                    {p}% off
                  </button>
                ))}
              </div>
            </div>

            {/* Quantity */}
            <div>
              <label className="block text-xs font-semibold text-gray-300 mb-1.5">
                Quantity <span className="text-emerald-400">*</span> <span className="text-gray-400 font-normal">(type or use buttons)</span>
              </label>
              <div className="flex items-center gap-2">
                <button 
                  type="button" 
                  onClick={() => {
                    const currentQty = parseFloat(formData.quantity) || 0;
                    if (currentQty > 0) {
                      const newQty = Math.max(0, currentQty - 1);
                      setQuantity(newQty);
                    }
                  }} 
                  className="w-9 h-9 rounded-xl bg-gray-950/60 border border-gray-800 flex items-center justify-center text-gray-300 hover:bg-gray-800 hover:text-white transition-all shrink-0 cursor-pointer"
                >
                  <Minus size={14}/>
                </button>
                <input 
                  type="number" 
                  name="quantity" 
                  value={formData.quantity} 
                  onChange={handleQuantityInput}
                  onBlur={handleBlur}
                  required 
                  min="0" 
                  step="0.01"
                  placeholder="0.00"
                  className={`w-full bg-gray-950/60 border rounded-xl py-3 text-xs text-white text-center placeholder-gray-500 outline-none transition-all shadow-inner ${errors.quantity ? "border-red-500/80 focus:ring-2 focus:ring-red-500/20" : "border-gray-800 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"}`}
                />
                <button 
                  type="button" 
                  onClick={() => {
                    const currentQty = parseFloat(formData.quantity) || 0;
                    setQuantity(currentQty + 1);
                  }} 
                  className="w-9 h-9 rounded-xl bg-gray-950/60 border border-gray-800 flex items-center justify-center text-gray-300 hover:bg-gray-800 hover:text-white transition-all shrink-0 cursor-pointer"
                >
                  <Plus size={14}/>
                </button>
              </div>
              {errors.quantity && <p className="text-[11px] text-red-400 mt-1 font-medium">{errors.quantity}</p>}

              <div className="flex gap-1.5 mt-2 flex-wrap">
                {[0.5, 1, 2, 5, 10].map(q => (
                  <button key={q} type="button" onClick={() => setQuantity(q)} 
                    className="text-[11px] font-semibold px-2.5 py-1 rounded-lg bg-gray-950/40 text-gray-400 border border-gray-800 hover:border-emerald-500/30 hover:text-white transition-all cursor-pointer">
                    {q}
                  </button>
                ))}
              </div>
            </div>

            {/* Unit */}
            <div>
              <label className="block text-xs font-semibold text-gray-300 mb-1.5">Unit <span className="text-emerald-400">*</span></label>
              <select name="unit" value={formData.unit} onChange={handleChange} className="w-full bg-gray-950/60 border border-gray-800 rounded-xl py-3 px-3.5 text-xs text-white outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all shadow-inner cursor-pointer">
                {UNITS.map(u => <option key={u} value={u} className="bg-gray-900 text-white">{u}</option>)}
              </select>
            </div>

            {/* Stock */}
            <div>
              <label className="block text-xs font-semibold text-gray-300 mb-1.5">
                Stock <span className="text-emerald-400">*</span> <span className="text-gray-400 font-normal">(type or use buttons)</span>
              </label>
              <div className="flex items-center gap-2">
                <button 
                  type="button" 
                  onClick={() => changeStock(-1)} 
                  className="w-9 h-9 rounded-xl bg-gray-950/60 border border-gray-800 flex items-center justify-center text-gray-300 hover:bg-gray-800 hover:text-white transition-all shrink-0 cursor-pointer"
                >
                  <Minus size={14}/>
                </button>
                <input 
                  type="number" 
                  name="stock" 
                  value={formData.stock} 
                  onChange={handleStockInput}
                  onBlur={handleBlur}
                  required 
                  min="1" 
                  placeholder="1"
                  className={`w-full bg-gray-950/60 border rounded-xl py-3 text-xs text-white text-center placeholder-gray-500 outline-none transition-all shadow-inner ${errors.stock ? "border-red-500/80 focus:ring-2 focus:ring-red-500/20" : "border-gray-800 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"}`}
                />
                <button 
                  type="button" 
                  onClick={() => changeStock(1)} 
                  className="w-9 h-9 rounded-xl bg-gray-950/60 border border-gray-800 flex items-center justify-center text-gray-300 hover:bg-gray-800 hover:text-white transition-all shrink-0 cursor-pointer"
                >
                  <Plus size={14}/>
                </button>
              </div>
              {errors.stock && <p className="text-[11px] text-red-400 mt-1 font-medium">{errors.stock}</p>}
            </div>

            {/* Expiry Date */}
            <div>
              <FormInput
                label="Expiry Date"
                name="expiryDate"
                type="date"
                required
                min={new Date().toISOString().split("T")[0]}
                value={formData.expiryDate}
                onChange={handleChange}
                onBlur={handleBlur}
                error={errors.expiryDate}
                touched={touched.expiryDate}
              />
              <div className="flex gap-1.5 mt-2 flex-wrap">
                {[{l:"+3 Days",d:3},{l:"+7 Days",d:7},{l:"+30 Days",d:30}].map(o => (
                  <button key={o.d} type="button" onClick={() => setExpiry(o.d)} 
                    className="text-[11px] font-semibold px-2.5 py-1 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20 hover:bg-amber-500/20 transition-all cursor-pointer">
                    {o.l}
                  </button>
                ))}
              </div>
            </div>

            {/* Product Image */}
            <div className="md:col-span-2">
              <label className="block text-xs font-semibold text-gray-300 mb-1.5">Product Image</label>
              <div className="flex items-center gap-4">
                {imagePreview && <img src={imagePreview} alt="" className="w-20 h-20 object-cover rounded-xl border border-gray-800 shadow-md shrink-0"/>}
                <label className="flex-1 flex items-center justify-center gap-2 p-4 bg-gray-950/40 border border-dashed border-gray-700 hover:border-emerald-500/50 rounded-2xl cursor-pointer transition-all group">
                  <Upload size={18} className="text-gray-400 group-hover:text-emerald-400 transition-colors"/>
                  <span className="text-xs font-semibold text-gray-300 group-hover:text-white transition-colors">{image ? "Change Image" : "Upload Product Image"}</span>
                  <input type="file" accept="image/jpeg,image/jpg,image/png,image/webp" onChange={handleImage} className="hidden"/>
                </label>
              </div>
              <p className="text-[11px] text-gray-400 mt-1">JPG, PNG, WEBP up to 5MB</p>
            </div>
          </div>

          {/* Form Actions Footer */}
          <div className="flex gap-3 pt-4 border-t border-gray-800/80 sticky bottom-0 bg-gray-900/90 backdrop-blur-md pb-1">
            <button 
              type="button" 
              onClick={handleClose} 
              className="flex-1 py-3 px-4 rounded-xl bg-gray-800 hover:bg-gray-700 text-gray-200 text-xs font-semibold transition-all border border-gray-700/60 cursor-pointer"
            >
              Cancel
            </button>
            <button 
              type="submit" 
              disabled={loading} 
              className="flex-1 py-3 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold transition-all shadow-lg shadow-emerald-600/20 border border-emerald-500/30 disabled:opacity-50 cursor-pointer"
            >
              {loading ? "Saving..." : editingProduct ? "Update Product" : "Post Product"}
            </button>
          </div>
        </form>
      </div>
    </div>,
    document.body
  );
};

export default ProductForm;
</file>

<file path="src/components/ProtectedRoute.jsx">
import { Navigate } from "react-router-dom";
import { useSelector } from "react-redux";

const ProtectedRoute = ({ children, allowedTypes, adminOnly}) => {
  const { user, isAuthenticated, loading } = useSelector((state) => state.auth);

  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-emerald-600"></div>
      </div>
    );
  }

  if (!isAuthenticated || !user) {
    return <Navigate to="/login" replace />;
  }

  // 👇 NEW: Admin bypass — admin can access any page

  if (user.isAdmin) {
    return children;
  }

  if (allowedTypes && !allowedTypes.includes(user.accountType) && !user.isAdmin) {
  return <Navigate to="/" replace />;
}

   // 👇 NEW: Admin check
  if (adminOnly && !user.isAdmin) {
    return <Navigate to="/" replace />;
  }

  return children;
};

export default ProtectedRoute;
</file>

<file path="src/components/RazorpayButton.jsx">
import { useState } from "react";
import { useDispatch } from "react-redux";
import axiosInstance from "../api/axiosInstance";
import { verifyAndPlaceOrder } from "../redux/thunks/orderThunks";
import toast from "react-hot-toast";

const RazorpayButton = ({ amount, productId, quantity, shippingAddress, onSuccess, validateShipping }) => {
  const dispatch = useDispatch();
  const [loading, setLoading] = useState(false);

  const handlePayment = async () => {
    // 👇 STEP 1: Run frontend validation first
    if (validateShipping && !validateShipping()) {
      return; // Validation failed, toast already shown
    }

    // 👇 STEP 2: Validate amount
    const numAmount = Number(amount);
    if (!amount || isNaN(numAmount) || numAmount <= 0) {
      toast.error("Invalid payment amount");
      console.error("Invalid amount:", amount);
      return;
    }

    // 👇 STEP 3: Validate shipping address (extra safety)
    if (!shippingAddress?.name || !shippingAddress?.phone || !shippingAddress?.street) {
      toast.error("Please fill all shipping details");
      return;
    }

    // 👇 STEP 4: Check Razorpay script loaded
    if (typeof window === "undefined" || !window.Razorpay) {
      toast.error("Payment system not loaded. Please refresh the page.");
      return;
    }

    setLoading(true);

    try {
      // 👇 STEP 5: Create order on backend
      const { data: order } = await axiosInstance.post("/orders/create-order", {
        amount: numAmount,
      });

      if (!order?.id) {
        throw new Error("Failed to create payment order");
      }

      // 👇 STEP 6: Open Razorpay checkout
      const options = {
        key: import.meta.env.VITE_RAZORPAY_KEY_ID,
        amount: order.amount,
        currency: order.currency || "INR",
        name: "expireOff",
        description: "Product Purchase",
        order_id: order.id,
        handler: async (response) => {
          try {
            // Verify payment on backend
            await dispatch(
              verifyAndPlaceOrder({
                razorpay_order_id: response.razorpay_order_id,
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_signature: response.razorpay_signature,
                productId,
                quantity,
                shippingAddress,
              })
            );
            toast.success("Order placed successfully!");
            onSuccess();
          } catch (err) {
            toast.error("Payment verification failed");
            console.error("Verification error:", err);
          }
        },
        prefill: {
          name: shippingAddress.name,
          email: shippingAddress.email || "",
          contact: shippingAddress.phone,
        },
        theme: { color: "#059669" },
        modal: {
          ondismiss: () => {
            setLoading(false);
          },
        },
      };

      const rzp = new window.Razorpay(options);

      rzp.on("payment.failed", (response) => {
        toast.error(response.error?.description || "Payment failed");
        setLoading(false);
      });

      rzp.open();
    } catch (error) {
      console.error("Payment error:", error);
      const msg = error.response?.data?.message || error.message || "Something went wrong";
      toast.error(msg);
      setLoading(false);
    }
  };

  return (
    <button
      onClick={handlePayment}
      disabled={loading}
      className="btn-primary w-full py-3 text-lg disabled:opacity-50"
    >
      {loading ? "Processing..." : `Pay ₹${amount}`}
    </button>
  );
};

export default RazorpayButton;
</file>

