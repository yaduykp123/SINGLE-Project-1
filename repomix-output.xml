import { useEffect, useState, useCallback } from "react";
import { useParams, useNavigate } from "react-router-dom";
import { useSelector, useDispatch } from "react-redux";
import { fetchProductById } from "../redux/thunks/productThunks";
import RazorpayButton from "../components/RazorpayButton";
import { 
  MapPin, Phone, Mail, User, Home, ArrowLeft, Minus, Plus, 
  AlertTriangle, Check, X, Leaf, ShieldCheck, Package, Truck, Navigation
} from "lucide-react";
import { getDeliveryTimeInfo } from "../utils/deliveryCalculator";
import { saveRecentlyViewedProduct } from "../utils/recentlyViewed";
import { 
  getEmailError, 
  getPhoneError, 
  getPincodeError, 
  getStreetError,
  getCityError,
  getStateError,
  validateForm
} from "../utils/validation";
import toast from "react-hot-toast";

// MOVED OUTSIDE: AddressInput is now a standalone component with dark-mode styling
const AddressInput = ({ name, type = "text", icon: Icon, placeholder, value, onChange, onBlur, error, touched }) => {
  const hasError = touched && error;
  const isValid = touched && !error && value;

  return (
    <div className="w-full">
      <div className="relative">
        {Icon && (
          <Icon size={16} className={`absolute left-3.5 top-1/2 -translate-y-1/2 transition-colors ${
            hasError ? "text-red-400" : isValid ? "text-emerald-400" : "text-gray-500"
          }`} />
        )}
        <input
          type={type}
          name={name}
          value={value}
          onChange={onChange}
          onBlur={onBlur}
          placeholder={placeholder}
          required
          className={`w-full bg-gray-950/60 border rounded-xl text-sm text-white placeholder-gray-500 outline-none backdrop-blur-xl transition-all shadow-inner py-3 ${
            Icon ? "pl-10" : "pl-4"
          } pr-10 ${
            hasError 
              ? "border-red-500/80 focus:border-red-500 focus:ring-2 focus:ring-red-500/20" 
              : isValid
              ? "border-emerald-500/80 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"
              : "border-gray-800 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"
          }`}
        />
        {touched && (
          <div className="absolute right-3.5 top-1/2 -translate-y-1/2">
            {hasError ? (
              <X size={15} className="text-red-400" />
            ) : (
              <Check size={15} className="text-emerald-400" />
            )}
          </div>
        )}
      </div>
      {hasError && (
        <p className="text-xs text-red-400 mt-1.5 flex items-center gap-1 font-medium">
          <X size={11} /> {error}
        </p>
      )}
    </div>
  );
};

const Checkout = () => {
  const { id } = useParams();
  const navigate = useNavigate();
  const dispatch = useDispatch();
  const { user } = useSelector((state) => state.auth);
  const { currentProduct, loading } = useSelector((state) => state.product);
  const [quantity, setQuantity] = useState(1);

  const [shippingAddress, setShippingAddress] = useState({
    name: "",
    phone: "",
    email: "",
    street: "",
    city: "",
    state: "",
    pincode: "",
  });

  const [errors, setErrors] = useState({});
  const [touched, setTouched] = useState({});
  const [isPrefilled, setIsPrefilled] = useState(false);

  useEffect(() => {
    dispatch(fetchProductById(id));
  }, [dispatch, id]);

  //  Save product to Recently Viewed 
  useEffect(() => {
    if (currentProduct && currentProduct._id) {
      saveRecentlyViewedProduct(currentProduct);
    }
  }, [currentProduct]);

  useEffect(() => {
    if (user && !isPrefilled) {
      const prefilled = {
        name: user.fullName || "",
        phone: user.phone || "",
        email: user.email || "",
        street: "",
        city: user.city || "",
        state: user.state || "",
        pincode: "",
      };
      setShippingAddress(prefilled);
      setIsPrefilled(true);
    }
  }, [user, isPrefilled]);

  const validateField = useCallback((name, value) => {
    switch (name) {
      case "name":
        return !value ? "Full name is required" : value.length < 2 ? "Name too short" : null;
      case "email":
        return getEmailError(value);
      case "phone":
        return getPhoneError(value);
      case "street":
        return getStreetError(value);
      case "city":
        return getCityError(value);
      case "state":
        return getStateError(value);
      case "pincode":
        return getPincodeError(value);
      default:
        return null;
    }
  }, []);

  const handleAddressChange = useCallback((e) => {
    const { name, value } = e.target;
    setShippingAddress(prev => ({ ...prev, [name]: value }));

    setErrors(prev => {
      if (!prev[name]) return prev;
      const newErrors = { ...prev };
      delete newErrors[name];
      return newErrors;
    });
  }, []);

  const handleBlur = useCallback((e) => {
    const { name, value } = e.target;
    setTouched(prev => ({ ...prev, [name]: true }));
    setErrors(prev => ({ ...prev, [name]: validateField(name, value) }));
  }, [validateField]);

  const handleQuantityChange = useCallback((delta) => {
    setQuantity(prev => {
      const newQty = prev + delta;
      if (newQty >= 1 && newQty <= (currentProduct?.stock || 1)) {
        return newQty;
      }
      return prev;
    });
  }, [currentProduct?.stock]);

  const handleOrderSuccess = useCallback(() => {
    navigate("/orders");
  }, [navigate]);

  const isShippingValid = useCallback(() => {
    const allTouched = { name: true, email: true, phone: true, street: true, city: true, state: true, pincode: true };
    setTouched(allTouched);

    const newErrors = {
      name: validateField("name", shippingAddress.name),
      email: validateField("email", shippingAddress.email),
      phone: validateField("phone", shippingAddress.phone),
      street: validateField("street", shippingAddress.street),
      city: validateField("city", shippingAddress.city),
      state: validateField("state", shippingAddress.state),
      pincode: validateField("pincode", shippingAddress.pincode),
    };
    setErrors(newErrors);

    const { isValid } = validateForm(newErrors);
    if (!isValid) {
      toast.error("Please fill all shipping details correctly");
    }
    return isValid;
  }, [shippingAddress, validateField]);

  const isExpired = currentProduct ? new Date(currentProduct.expiryDate) <= new Date() : false;

  if (loading || !currentProduct) {
    return (
      <div className="min-h-screen bg-[#0b0f19] flex items-center justify-center">
        <div className="animate-spin rounded-full h-10 w-10 border-2 border-emerald-500 border-t-transparent"></div>
      </div>
    );
  }

  const totalAmount = currentProduct.discountPrice * quantity;
  const discountPercent = Math.round(
    ((currentProduct.marketPrice - currentProduct.discountPrice) / currentProduct.marketPrice) * 100
  );

  return (
    <div className="min-h-screen bg-[#0b0f19] text-gray-100 p-4 md:p-8 relative overflow-hidden selection:bg-emerald-500 selection:text-white">
      {/* Background Glow Elements */}
      <div className="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-emerald-600/10 blur-[130px] rounded-full pointer-events-none" />

      <div className="max-w-6xl mx-auto relative z-10">
        <button
          onClick={() => navigate(-1)}
          className="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-emerald-400 mb-6 transition-colors font-medium"
        >
          <ArrowLeft size={16} />
          <span>Back to Products</span>
        </button>

        <div className="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {/* Product Details */}
          <div>
            <div className="bg-gray-900/60 border border-gray-800/80 backdrop-blur-xl rounded-2xl p-6 shadow-xl">
              <div className="relative w-full h-64 bg-gray-950/80 rounded-xl overflow-hidden border border-gray-800/60 flex items-center justify-center p-4 mb-6">
                <img
                  src={currentProduct.image || "https://via.placeholder.com/500x300?text=No+Image"}
                  alt={currentProduct.name}
                  className="w-full h-full object-contain"
                />

                {discountPercent > 0 && (
                  <div className="absolute top-3 left-3 bg-emerald-500/90 text-white border border-emerald-400/30 text-xs font-bold px-3 py-1 rounded-full shadow-lg backdrop-blur-md">
                    {discountPercent}% OFF
                  </div>
                )}
              </div>

              <div className="flex items-start justify-between mb-3">
                <div>
                  <h1 className="text-2xl font-bold text-white tracking-tight">{currentProduct.name}</h1>
                  <p className="text-sm text-gray-400">{currentProduct.brand}</p>
                </div>
              </div>

              <p className="text-sm text-gray-300 mb-6 leading-relaxed">{currentProduct.description}</p>

              <div className="flex items-baseline gap-3 mb-6">
                <span className="text-3xl font-bold text-emerald-400">
                  ₹{currentProduct.discountPrice}
                </span>
                <span className="text-base text-gray-500 line-through">
                  ₹{currentProduct.marketPrice}
                </span>
              </div>

              <div className="grid grid-cols-2 gap-3 text-sm mb-6">
                <div className="bg-gray-950/40 border border-gray-800/80 p-3.5 rounded-xl">
                  <span className="text-xs text-gray-500 block mb-0.5">Category</span>
                  <p className="font-semibold text-white">{currentProduct.category}</p>
                </div>
                <div className="bg-gray-950/40 border border-gray-800/80 p-3.5 rounded-xl">
                  <span className="text-xs text-gray-500 block mb-0.5">Available</span>
                  <p className="font-semibold text-white">{currentProduct.stock} in stock</p>
                </div>
                <div className="bg-gray-950/40 border border-gray-800/80 p-3.5 rounded-xl">
                  <span className="text-xs text-gray-500 block mb-0.5">Quantity</span>
                  <p className="font-semibold text-white">{currentProduct.quantity} {currentProduct.unit}</p>
                </div>
                <div className="bg-gray-950/40 border border-gray-800/80 p-3.5 rounded-xl">
